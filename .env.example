# Optional remote diagnosis adapter. Empty values keep the local rule provider active.
DIAGNOSIS_PROVIDER=rule-based
REMOTE_MODEL_BASE_URL=
REMOTE_MODEL_NAME=
REMOTE_MODEL_API_KEY=

# Optional equipment telemetry adapter.
TELEMETRY_PROVIDER=submitted-facts
INDUSTRIAL_GATEWAY_URL=
INDUSTRIAL_GATEWAY_TOKEN=

# Local attachment storage for development.
ATTACHMENT_STORAGE_ROOT=run/attachments
ATTACHMENT_MAX_BYTES=20971520

# SQLite path can be overridden by a deployment wrapper.
PRESENTATION_DATABASE_PATH=backend/data/presentation/presentation.db
