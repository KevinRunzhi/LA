LA_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
JSON_ACCESS_LOG=true
READINESS_REQUIRES_FRONTEND=false
TRUST_PROXY_HEADERS=false
CORS_ALLOWED_ORIGINS=*
FRONTEND_DIST_PATH=frontend/dist

# Optional remote diagnosis adapter. Empty values keep the local rule provider active.
DIAGNOSIS_PROVIDER=rule-based
REMOTE_MODEL_BASE_URL=
REMOTE_MODEL_NAME=
REMOTE_MODEL_API_KEY=

# Optional equipment telemetry adapter.
TELEMETRY_PROVIDER=submitted-facts
INDUSTRIAL_GATEWAY_URL=
INDUSTRIAL_GATEWAY_TOKEN=

# Local attachment storage for development.
ATTACHMENT_STORAGE_ROOT=run/attachments
ATTACHMENT_MAX_BYTES=20971520

# Identity compatibility: compat preserves the recorded demo actor contract;
# enforced requires a Bearer session for all protected CaseRun APIs.
LA_AUTH_MODE=compat
LA_SESSION_TTL_SECONDS=28800
LA_LOGIN_MAX_FAILURES=5
LA_LOGIN_LOCK_SECONDS=900
LA_BOOTSTRAP_ADMIN_ACCOUNT=
LA_BOOTSTRAP_ADMIN_PASSWORD=

# Indexed PDF manuals and immutable server-generated job cards.
LA_MANUAL_STORAGE_ROOT=run/manuals
LA_MANUAL_MAX_BYTES=52428800
LA_JOB_CARD_STORAGE_ROOT=run/job-cards

# SQLite path is resolved relative to the repository root.
PRESENTATION_DATABASE_PATH=backend/data/presentation/presentation.db

# Gunicorn production process settings.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200
