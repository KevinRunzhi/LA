{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la.local/schemas/case-feedback-graph-1.1.json",
  "title": "LA case feedback and graph module",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "knowledgeProposal", "graphProposal"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "knowledgeProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledgeId", "title", "verificationLevel", "summary"],
      "properties": {
        "knowledgeId": {"type": "string", "pattern": "^KB-[A-Z0-9-]{2,100}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 150},
        "verificationLevel": {"type": "string", "enum": ["official_document", "synthetic_demo", "field_evidence", "expert_confirmed", "verified_case"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "graphProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledgeId", "nodes", "relations"],
      "properties": {
        "knowledgeId": {"type": "string", "pattern": "^KB-[A-Z0-9-]{2,100}$"},
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "type", "verificationLevel"],
            "properties": {
              "id": {"type": "string", "pattern": "^node-[a-z0-9-]{3,100}$"},
              "name": {"type": "string", "minLength": 1, "maxLength": 150},
              "type": {"type": "string", "enum": ["device", "alarm", "symptom", "cause", "action", "result", "threshold", "case"]},
              "verificationLevel": {"type": "string", "enum": ["official_document", "synthetic_demo", "field_evidence", "expert_confirmed", "verified_case"]}
            }
          }
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "relation", "target", "verificationLevel"],
            "properties": {
              "id": {"type": "string", "pattern": "^relation-[a-z0-9-]{3,100}$"},
              "source": {"type": "string", "pattern": "^node-[a-z0-9-]{3,100}$"},
              "relation": {"type": "string", "minLength": 1, "maxLength": 80},
              "target": {"type": "string", "pattern": "^node-[a-z0-9-]{3,100}$"},
              "verificationLevel": {"type": "string", "enum": ["official_document", "synthetic_demo", "field_evidence", "expert_confirmed", "verified_case"]}
            }
          }
        }
      }
    }
  }
}
