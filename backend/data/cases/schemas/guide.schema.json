{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la.local/schemas/case-guide-1.1.json",
  "title": "LA case guide module",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planTitle", "steps"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "planTitle": {"type": "string", "minLength": 1, "maxLength": 120},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "checks", "measurements", "claimIds", "assistantTopicIds", "completionCriteria"],
        "properties": {
          "id": {"type": "string", "pattern": "^step-[a-z0-9-]{3,100}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "required", "locked", "claimIds"],
              "properties": {
                "id": {"type": "string", "pattern": "^check-[a-z0-9-]{3,100}$"},
                "label": {"type": "string", "minLength": 1, "maxLength": 300},
                "required": {"type": "boolean"},
                "locked": {"type": "boolean"},
                "claimIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^claim-[a-z0-9-]{3,100}$"}
                }
              }
            }
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "unit", "required"],
              "properties": {
                "id": {"type": "string", "pattern": "^measurement-[a-z0-9-]{3,100}$"},
                "label": {"type": "string", "minLength": 1, "maxLength": 200},
                "unit": {"type": "string", "enum": ["V", "mV", "rpm", "°C", "min", "state"]},
                "required": {"type": "boolean"}
              }
            }
          },
          "claimIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^claim-[a-z0-9-]{3,100}$"}
          },
          "assistantTopicIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^topic-[a-z0-9-]{3,100}$"}
          },
          "completionCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["refId", "condition"],
              "properties": {
                "refId": {"type": "string", "pattern": "^(check|measurement)-[a-z0-9-]{3,100}$"},
                "condition": {"type": "string", "minLength": 1, "maxLength": 200}
              }
            }
          }
        }
      }
    }
  }
}
