{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la.local/schemas/case-assistant-1.1.json",
  "title": "LA case assistant module",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fallback", "topics"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "fallback": {"type": "string", "minLength": 1, "maxLength": 500},
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "intents", "answer", "allowedStepIds", "claimIds"],
        "properties": {
          "id": {"type": "string", "pattern": "^topic-[a-z0-9-]{3,100}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 100},
          "intents": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 100}
          },
          "answer": {"type": "string", "minLength": 1, "maxLength": 2000},
          "allowedStepIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^step-[a-z0-9-]{3,100}$"}
          },
          "claimIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^claim-[a-z0-9-]{3,100}$"}
          }
        }
      }
    }
  }
}
