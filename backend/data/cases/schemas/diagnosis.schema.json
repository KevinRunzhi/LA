{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la.local/schemas/case-diagnosis-1.1.json",
  "title": "LA case diagnosis module",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "direction", "riskLevel", "summary", "evidence", "agents"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "direction": {"type": "string", "minLength": 1, "maxLength": 150},
    "riskLevel": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "claimId", "intakeFieldIds"],
        "properties": {
          "id": {"type": "string", "pattern": "^evidence-[a-z0-9-]{3,100}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 300},
          "claimId": {"type": "string", "pattern": "^claim-[a-z0-9-]{3,100}$"},
          "intakeFieldIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^field-[a-z0-9-]{3,100}$"}
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "stageSummary"],
        "properties": {
          "id": {"type": "string", "pattern": "^agent-[a-z0-9-]{3,100}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "role": {"type": "string", "minLength": 1, "maxLength": 160},
          "stageSummary": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
