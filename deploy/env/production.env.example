LA_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO
JSON_ACCESS_LOG=true
READINESS_REQUIRES_FRONTEND=true
TRUST_PROXY_HEADERS=true
CORS_ALLOWED_ORIGINS=

PRESENTATION_DATABASE_PATH=run/data/presentation.db
ATTACHMENT_STORAGE_ROOT=run/attachments
ATTACHMENT_MAX_BYTES=20971520
LA_AUTH_MODE=enforced
LA_SESSION_TTL_SECONDS=28800
LA_LOGIN_MAX_FAILURES=5
LA_LOGIN_LOCK_SECONDS=900
LA_BOOTSTRAP_ADMIN_ACCOUNT=
LA_BOOTSTRAP_ADMIN_PASSWORD=
LA_MANUAL_STORAGE_ROOT=run/manuals
LA_MANUAL_MAX_BYTES=52428800
LA_JOB_CARD_STORAGE_ROOT=run/job-cards
LA_EXPORT_STORAGE_ROOT=run/exports
LA_PLATFORM_BACKUP_ROOT=run/platform-backups
LA_CASE_AUTHORING_ROOT=run/case-authoring
FRONTEND_DIST_PATH=frontend/dist

GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=2000
GUNICORN_MAX_REQUESTS_JITTER=200

DIAGNOSIS_PROVIDER=rule-based
REMOTE_MODEL_BASE_URL=
REMOTE_MODEL_NAME=
REMOTE_MODEL_API_KEY=

CASE_GENERATION_PROVIDER=structured-local
CASE_GENERATION_REMOTE_URL=
CASE_GENERATION_REMOTE_MODEL=
CASE_GENERATION_REMOTE_API_KEY=
CASE_GENERATION_TIMEOUT_SECONDS=45
CASE_GENERATION_MAX_RESPONSE_BYTES=1000000

TELEMETRY_PROVIDER=submitted-facts
INDUSTRIAL_GATEWAY_URL=
INDUSTRIAL_GATEWAY_TOKEN=
